#!/usr/bin/env python3
"""Read-only deployed readiness and authenticated account smoke check."""
import json
import os
from urllib.request import Request, urlopen

base = os.environ.get("DENIALNET_URL", "http://localhost:8001").rstrip("/")
agent = os.environ["DENIALNET_AGENT_ID"]
key = os.environ["DENIALNET_API_KEY"]
for path in ("/health", "/ready", f"/credits/{agent}"):
    with urlopen(Request(base + path, headers={"X-API-Key": key}), timeout=15) as response:
        assert response.status == 200
        json.load(response)
    print(f"PASS {path}")
